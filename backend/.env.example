# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DSPy teacher/student split (any OpenRouter model ids)
TEACHER_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
STUDENT_MODEL=openrouter/openai/gpt-oss-20b:free

# Neo4j — either a local docker instance (bolt://neo4j:7687) or Neo4j Aura (neo4j+s://xxxx.databases.neo4j.io)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplierrisk
NEO4J_DATABASE=neo4j

# where sqlite/faiss/compiled state live
DATA_DIR=/app/data
